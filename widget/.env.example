# Widget environment variables

# Backend API URL
VITE_API_BASE_URL=http://localhost:8080

# Marketing link URL shown in "Powered by" branding
VITE_MARKETING_URL=https://botla.app

# Dashboard origin(s) allowed to send Playground WIDGET_CONFIG messages and to
# receive WIDGET_EVENT_* messages (comma-separated, exact origins).
# Defaults to https://botla.app,https://www.botla.app when unset.
# Dev builds additionally trust http://localhost:5173 and http://localhost:3000.
# VITE_DASHBOARD_URL=https://botla.app

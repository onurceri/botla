# Botla backend configuration. Copy to .env and fill in the secrets:
#   cp .env.example .env
# Values below match the local stack from `make up` (docker-compose.dev.yml).

# --- Server -------------------------------------------------------------------
PORT=8080
# "production" turns on Secure cookies and DB_SSLMODE=require by default.
GO_ENV=development
# Comma-separated origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Optional: share auth cookies across subdomains, e.g. .example.com
# COOKIE_DOMAIN=

# --- Auth ---------------------------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars

# --- PostgreSQL ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=botla_dev
DB_USER=botla
DB_PASSWORD=botla
# DB_SCHEMA=public
# DB_SSLMODE=disable

# --- Redis (required: rate limiting) ------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Qdrant -------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- LLM providers ------------------------------------------------------------
# OpenAI is used for embeddings (text-embedding-3-small) and chat models.
OPENAI_API_KEY=sk-...
# Optional: route chat models through OpenRouter.
OPENROUTER_API_KEY=
# Optional: fallback chat model (bare id, resolved to openai/<id> on OpenRouter).
# Defaults to gpt-6-luna (GPT-6 Luna); gpt-4o-mini, gpt-4o and gpt-5 remain valid.
# DEFAULT_CHATBOT_MODEL=gpt-6-luna

# --- Object storage (optional) ------------------------------------------------
# Cloudflare R2 / S3-compatible storage for uploaded files, privacy exports and
# tokenizer data. Leave R2_ACCOUNT_ID empty to run without it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- RAG tuning (optional) ----------------------------------------------------
# RAG_TOPK=5
# RAG_MAX_CONTEXT_TOKENS=2000
# Split multi-part questions into sub-queries before search (one extra LLM call;
# see evals/README.md for the measured effect).
# RAG_QUERY_DECOMPOSITION=false

# --- Workers and scraping (optional) ------------------------------------------
# WORKER_COUNT=4
# SCRAPER_BROWSER_PATH=/usr/bin/chromium
# SCRAPER_BROWSER_POOL_SIZE=2

# --- Rate limiting (optional; unset uses the built-in defaults) ---------------
# RATE_LIMIT_GLOBAL_REQUESTS_PER_MINUTE=60
# RATE_LIMIT_USER_REQUESTS_PER_MINUTE=120
# RATE_LIMIT_ENDPOINT_CHAT=20
# RATE_LIMIT_ENDPOINT_SOURCES=10

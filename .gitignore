# Root ignore rules for the whole monorepo. frontend/ and widget/ add a few
# tool-specific rules in their own .gitignore files.

# --- Environment and secrets -------------------------------------------------
# Real env files never get committed; the documented templates do.
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.crt

# --- Go build output --------------------------------------------------------
/server
bin/
vendor/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.o
*.a
*.test

# --- Go coverage and profiling ----------------------------------------------
*.out
*.coverprofile
coverage.html
*.prof
*.pprof

# --- Node / web builds ------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.next/
.cache/
*.tsbuildinfo
.eslintcache

# --- Test and coverage reports ----------------------------------------------
coverage/
.nyc_output/
coverage-final.json
lcov-report/
*.lcov
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- RAG evals (evals/reports/baseline.md stays committed) -------------------
.evalcache/
evals/reports/latest/

# --- Local data --------------------------------------------------------------
*.db
database.backup
logs/
*.log
# Tokenizer data is loaded from R2 in production.
data/sentences/
docs/test.pdf

# --- Local tooling and agent scratch space ----------------------------------
.direnv/
.agent/
.sisyphus/
docs/temp/

# --- Editors and OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
